NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dawostock?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS — frontend origin
CLIENT_URL=http://localhost:5173

# Optional file upload limits (MB)
MAX_UPLOAD_MB=5
